APP_NAME=Siger API
APP_ENV=development
API_V1_PREFIX=/api/v1

POSTGRES_USER=siger
POSTGRES_PASSWORD=change_me
POSTGRES_DB=siger_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenRouter (https://openrouter.ai/keys). Keep the real key in backend/.env only.
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free models (demo setup). Paid alternative: openai/gpt-4o-mini with
# openai/text-embedding-3-small (1536 dims). Changing the embedding model means
# deleting the Qdrant collection and re-uploading course material.
CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMENSIONS=2048

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=course_chunks
QDRANT_ANSWER_KEY_COLLECTION=answer_keys

RETRIEVAL_TOP_K=5
# Calibrated for nvidia/nemotron-3-embed-1b; re-tune if the embedding model changes.
RETRIEVAL_MIN_SCORE=0.25
