APP_NAME=Siger API
APP_ENV=development
API_V1_PREFIX=/api/v1

POSTGRES_USER=siger
POSTGRES_PASSWORD=change_me
POSTGRES_DB=siger_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenRouter (https://openrouter.ai/keys). Keep the real key in backend/.env only.
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free models (demo setup). Paid alternative: openai/gpt-4o-mini with
# openai/text-embedding-3-small (1536 dims). Changing the embedding model means
# deleting the Qdrant collection and re-uploading course material.
CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMENSIONS=2048
# Retries for timeouts/empty replies, and how many chat calls may run at once.
LLM_MAX_ATTEMPTS=3
LLM_MAX_PARALLEL=3

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=course_chunks
QDRANT_ANSWER_KEY_COLLECTION=answer_keys

RETRIEVAL_TOP_K=5
# Calibrated for nvidia/nemotron-3-embed-1b; re-tune if the embedding model changes.
RETRIEVAL_MIN_SCORE=0.25

# Grading: similarity in [LOW, HIGH] maps to an expected score of 0..100%.
# Calibrated for nemotron-3-embed-1b (wrong ~0.43, partial ~0.49, correct ~0.62-0.70). Below MIN_CONFIDENCE a question is re-checked.
GRADING_SIMILARITY_LOW=0.35
GRADING_SIMILARITY_HIGH=0.70
GRADING_MIN_CONFIDENCE=0.6
GRADING_CONCURRENCY=2
GRADING_TIMEOUT_SECONDS=900

# A topic below this class mastery is reported as a learning gap.
LEARNING_GAP_THRESHOLD=0.5
